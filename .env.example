# Copy this file to .env and fill in the values. Never commit .env.

# Port the server listens on.
PORT=3000

# ---------- AI ----------
# Your Anthropic API key (https://console.anthropic.com). Without it the
# product runs in free demo mode with placeholder answers.
ANTHROPIC_API_KEY=

# Optional: which Claude model answers calls, and how hard it thinks during
# live calls. Lower effort = faster replies, which matters on the phone.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# ---------- Phone calls & messages (Twilio) ----------
# Account SID + auth token from the Twilio console. The auth token is also
# used to verify that webhook requests really come from Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your server's public HTTPS address, exactly as entered in Twilio (no trailing slash).
PUBLIC_URL=https://your-domain.example
# Number that outbound campaign calls come from (a Twilio number you own).
TWILIO_CALLER_ID=
# Senders for customer follow-ups. WhatsApp needs an approved WhatsApp sender in Twilio.
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ---------- Premium natural voices (optional) ----------
# ElevenLabs text-to-speech for a more human voice on phone calls. Receptionists
# set to "Premium natural voice" use it for the languages listed below; other
# languages (and any error) fall back to the standard voices. Needs PUBLIC_URL.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Check ElevenLabs' current language list for the model you choose.
ELEVENLABS_LANGUAGES=en-IN,en-US,hi-IN,ta-IN

# ---------- Real-time voice ----------
# Receptionists set to "Real-time" use Twilio ConversationRelay (streaming
# replies, barge-in). It needs PUBLIC_URL above and ConversationRelay enabled
# on your Twilio account; without them calls use the standard mode.

# ---------- Voice engine (VoiceDesk's own ears and mouth) ----------
# Platform-wide defaults; each business can also add its own keys in
# Dashboard → Phone & voice. See docs/VOICE-ENGINE.md.
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
# ELEVENLABS_API_KEY is listed above under premium voices.
# Your own voice server (POST {text, language, voice, sample_rate} → WAV/PCM)
CUSTOM_TTS_URL=
CUSTOM_TTS_KEY=

# ---------- Phone companies (platform defaults; businesses add their own in the dashboard) ----------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_FLOW_ID=

# ---------- Instagram DM & Messenger (Meta) ----------
# From your Meta developer app. The page access token can also be pasted in
# the dashboard (Settings → Channels) for each business.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=

# ---------- Platform ----------
# Comma-separated emails of the VoiceDesk team; they see the Admin console.
ADMIN_EMAILS=
# Max sign-ups per network per hour (anti-abuse).
SIGNUP_RATE_LIMIT=10
# Set to 1 when running behind a load balancer / reverse proxy, so rate limits see real client IPs.
TRUST_PROXY=

# Where the JSON database file lives.
DATA_FILE=./data/db.json
